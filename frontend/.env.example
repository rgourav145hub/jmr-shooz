# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Database (PostgreSQL direct connection)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Secret for auth tokens (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=generate-a-random-64-byte-hex-string-here

# ============================================
# GMAIL SMTP — OTP Email Delivery (FREE)
# ============================================
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
GMAIL_FROM_NAME=JMR Shooz Footwear
